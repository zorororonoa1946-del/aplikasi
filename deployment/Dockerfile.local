# Copy the pinned Debian OpenSSL runtime into the matching slim image. No apt
# mirror or package installation is needed when the owner builds the server.
FROM node:24-bookworm@sha256:6449e19d8184d84062525b6a7524def03146c2cb04a7f08b076680d0e8e4240a AS crypto-runtime
FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
COPY --from=crypto-runtime /usr/bin/openssl /usr/bin/openssl
COPY --from=crypto-runtime /usr/lib/*-linux-gnu/libssl.so.3 /usr/local/lib/
COPY --from=crypto-runtime /usr/lib/*-linux-gnu/libcrypto.so.3 /usr/local/lib/
COPY --from=crypto-runtime /etc/ssl/openssl.cnf /etc/ssl/openssl.cnf
ENV OPENSSL_CONF=/etc/ssl/openssl.cnf
RUN ldconfig && openssl version
WORKDIR /app
COPY --chown=node:node package.json server.js ./
COPY --chown=node:node public ./public
COPY --chown=node:node scripts/relay-local.mjs ./scripts/relay-local.mjs
RUN mkdir /data && chown node:node /data
ENV NODE_ENV=production LOCAL_RELAY_DIR=/data
USER node
EXPOSE 3443
ENTRYPOINT ["node", "scripts/relay-local.mjs"]
